# Names only. Copy to the ignored .env and fill privately. Production values live in Fly secrets.

# Legacy TMS
TMS_HOST=
TMS_PORT=
TMS_TOKEN=
# Handbook access only, not used by the TMS protocol
TMS_DOCS_PASSWORD=

# FMCSA. Works from Fly.io; the local machine gets HTTP 403
FMCSA_API_KEY=

# Twin SQL API
HAPPYROBOT_API_KEY=
HAPPYROBOT_ORG_ID=
# Explicit production or staging. Isolated candidate acceptance uses staging.
TWIN_ENVIRONMENT=production
# Optional dedicated workflow integration provenance, used for fresh recording links.
# Configure both only when AGENT_API_KEY belongs to this trusted workflow.
# HAPPYROBOT_WORKSPACE_SLUG=fdesantiagogonzalezalvarez
# HAPPYROBOT_WORKFLOW_ID=6oaskq84xpfc

# Service keys, one per caller, at least 24 characters
AGENT_API_KEY=
OPS_API_KEY=

# Secrets for code hashing and price seeding, at least 24 characters
OTP_HASH_SECRET=
PRICING_SECRET=

# Code email, sent over Gmail SMTP to one demo inbox
OTP_EMAIL_USER=
OTP_EMAIL_CREDENTIAL=
DEMO_OTP_EMAIL=

# Optional pilot roster managed by the broker. Omit for the approved demo inbox.
# An explicitly empty roster denies every send. Never add real contacts to git.
# OTP_CONTACTS_JSON={"138328":"carrier@example.test"}

# Behaviour
# real or synthetic, stamped on each new call
CALL_COHORT=real
# Keep sends off for the demo inbox. A pilot needs enrolled contacts and explicit approval.
LIVE_BOOKING=false
