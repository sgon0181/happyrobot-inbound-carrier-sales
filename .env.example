# Names only. Copy to ignored .env and provision authorized values privately.
# Required by scripts/query_loads.py. Its parser reads this local file directly.
TMS_HOST=
TMS_PORT=
TMS_TOKEN=

# Documentation access only, not consumed by the TMS reader or wire protocol.
TMS_DOCS_PASSWORD=

# Isolated prototype service. Provision values privately for this branch only.
# FMCSA access comes from the candidate portal. HappyRobot access must be approved.
FMCSA_API_KEY=
HAPPYROBOT_API_KEY=
HAPPYROBOT_ORG_ID=
DEMO_OTP_EMAIL=
AGENT_API_KEY=
OPS_API_KEY=
OTP_EMAIL_USER=
OTP_EMAIL_CREDENTIAL=
OTP_HASH_SECRET=
PRICING_SECRET=

# Default off. Rehearsal checks real consent without sending a booking.
BOOKING_MODE=off

# Existing prototype workflow and Twin namespace. Native consent checks this ID.
PROTOTYPE_WORKFLOW_ID=
TWIN_TABLE_PREFIX=proto_
# Private ephemeral journal. Export before replacement.
RECEIPT_JOURNAL_DIR=/tmp/carrier-receipts
